{
  "name": "@jevlinsearch/ai-sdk",
  "version": "0.1.0",
  "description": "Jevlin SuperSearch as a tool for the AI SDK: one call asks several search engines at once and returns one merged list, every result naming the engines that found it.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai-sdk",
    "vercel",
    "ai",
    "tool",
    "web-search",
    "search",
    "jevlin",
    "supersearch",
    "agents"
  ],
  "homepage": "https://docs.jevlin.ai/integrations/ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jevlinai/jevlin-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/jevlinai/jevlin-ai-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
